#cloud-config
hostname: ${hostname}
fqdn: ${fqdn_private}
prefer_fqdn_over_hostname: true

timezone: Asia/Shanghai

ssh_pwauth: false

users:
  - name: geektr
    gecos: admin user
    primary_group: geektr
    shell: /bin/bash
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-rsa  geektr@geektr.co

package_update: true
package_upgrade: true
packages:
  - axel
  - curl
  - dnsutils
  - git-lfs
  - htop
  - jq
  - mtr
  - net-tools
  - rsync
  - screen
  - software-properties-common
  - tmux
  - tree
  - unzip
  - vim
  - wget
  - zip

write_files:
  - path: /etc/rancher/k3s/registries.yaml
    owner: root:root
    content: |
      mirrors:
        "docker.io":
          endpoint:
            - "https://dcr.oci.anitya.net"
        "ghcr.io":
          endpoint:
            - "https://ghcr.oci.anitya.net"
        "gcr.io":
          endpoint:
            - "https://gcr.oci.anitya.net"
        "k8s.gcr.io":
          endpoint:
            - "https://k8s.oci.anitya.net"
        "registry.k8s.io":
          endpoint:
            - "https://k8s.oci.anitya.net"
        "quay.io":
          endpoint:
            - "https://quay.oci.anitya.net"
        "mcr.microsoft.com":
          endpoint:
            - "https://mcr.oci.anitya.net"
        "nvcr.io":
          endpoint:
            - "https://nvcr.oci.anitya.net"

  - path: /var/lib/rancher/k3s/server/manifests/cert-manager.yaml
    owner: root:root
    content: |
      apiVersion: v1
      kind: Namespace
      metadata:
        name: cert-manager
      ---
      apiVersion: helm.cattle.io/v1
      kind: HelmChart
      metadata:
        name: cert-manager
        namespace: cert-manager
      spec:
        repo: https://charts.anitya.net/cert-manager
        chart: cert-manager
        targetNamespace: cert-manager
        version: v1.18.2
        valuesContent: |-
          installCRDs: true
          extraArgs:
            - --dns01-recursive-nameservers-only
            - --dns01-recursive-nameservers=1.1.1.1:53
          nodeSelector:
            node-role.kubernetes.io/master: "true"
          webhook:
            nodeSelector:
              node-role.kubernetes.io/master: "true"
          cainjector:
            nodeSelector:
              node-role.kubernetes.io/master: "true"

  - path: /var/lib/rancher/k3s/server/manifests/keel.yaml
    owner: root:root
    content: |
      apiVersion: helm.cattle.io/v1
      kind: HelmChart
      metadata:
        name: keel
        namespace: kube-system
      spec:
        repo: https://charts.anitya.net/keel
        chart: keel
        targetNamespace: kube-system
        version: v1.0.5

  - path: /var/lib/rancher/k3s/server/manifests/openebs.yaml
    owner: root:root
    content: |
      apiVersion: v1
      kind: Namespace
      metadata:
        name: openebs
      ---
      apiVersion: helm.cattle.io/v1
      kind: HelmChart
      metadata:
        name: openebs
        namespace: openebs
      spec:
        repo: https://charts.anitya.net/openebs
        chart: openebs
        targetNamespace: openebs
        version: v4.3.3
        set:
          engines.local.lvm.enabled: "false"
          engines.local.zfs.enabled: "false"
          engines.replicated.mayastor.enabled: "false"
          localpv-provisioner.hostpathClass.enabled: "true"
          localpv-provisioner.hostpathClass.basePath: /mnt/k3s-data/volumes
          localpv-provisioner.hostpathClass.reclaimPolicy: Retain
          localpv-provisioner.hostpathClass.isDefaultClass: "false"

  - path: /etc/rancher/k3s/config.yaml
    owner: root:root
    content: |
      ${jsonencode(k3s_config)}

runcmd:
  - |
    curl -sfL \
      https://rancher-mirror.rancher.cn/k3s/k3s-install.sh | \
      INSTALL_K3S_MIRROR=cn sh -s - \
      --system-default-registry "dcr.oci.anitya.net"

disk_setup:
  /dev/vdb:
    table_type: gpt
    layout: false
    overwrite: true

fs_setup:
  - label: k3s-data
    filesystem: ext4
    device: /dev/vdb

mounts:
  - ["/dev/vdb", "/mnt/k3s-data"]
