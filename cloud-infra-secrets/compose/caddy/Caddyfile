*.geektr.co {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	header -Server

	@vault host vault.geektr.co
	reverse_proxy @vault vault:8200

	@vaultwarden host bitwarden.geektr.co
	reverse_proxy @vaultwarden vaultwarden:80 {
		header_up X-Real-IP {http.request.remote}
	}

	@certimate host certimate.geektr.co
	reverse_proxy @certimate certimate:8090

	@keycloak host auth.geektr.co
	reverse_proxy @keycloak keycloak:8080
}
